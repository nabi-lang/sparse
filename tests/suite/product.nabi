use pkg::tests::suite::{dense, random, rvec};
use pkg::{Csr, SparseError};
use core::array::{Matrix, Vector};

#[test]
fn matvec_matches_dense() {
    for seed in 1u64..8 {
        let a = random(30, 20, 4, 0.0, seed);
        let x = rvec(20, seed + 100);
        let y = try! a.matvec(x);
        let want = try! linalg::matvec(dense(a), x);
        assert(y.all_close(want, abs: 1e-14));
        assert((try! a.to_csc().matvec(x)).all_close(want, abs: 1e-14));
        let z = rvec(30, seed + 200);
        let wt = try! linalg::matvec(dense(a).t(), z);
        assert((try! a.rmatvec(z)).all_close(wt, abs: 1e-14));
        assert((try! a.to_csc().rmatvec(z)).all_close(wt, abs: 1e-14));
    }
}

#[test]
fn matvec_inputs() {
    let a = pkg::eye(3).scale(2.0);
    let want: Vector<f64> = [2, 4, 6];
    assert(try! a.matvec([1, 2, 3]) == want);
    assert(try! a.matvec([1.0, 2.0, 3.0]) == want);
    assert(try! a.matvec([1.0f32, 2.0f32, 3.0f32]) == want);
    assert(try! a.matvec(1..4) == want);
    assert(try { _ = try a.matvec([1, 2]); false } catch e: SparseError { f"{e}".contains("3 x 3") });
}

#[test]
fn products() {
    for seed in 1u64..6 {
        let a = random(12, 9, 3, 0.0, seed);
        let b = random(9, 11, 2, 0.0, seed + 50);
        let c = try! a.matmul(b);
        let want = try! linalg::matmul(dense(a), dense(b));
        assert(c.to_dense().all_close(want, abs: 1e-14));
        assert((try! a.to_csc().matmul(b.to_csc())).to_dense().all_close(want, abs: 1e-14));
        let m: Matrix<f64> = dense(b);
        assert((try! a.matmul_dense(m)).all_close(want, abs: 1e-14));
        // Indices stay sorted.
        let ix = c.indices();
        for i in 0..12 {
            for p in c.indptr()[i] + 1..c.indptr()[i + 1] { assert(ix[p] > ix[p - 1]); }
        }
    }
    assert(try { _ = try pkg::eye(2).matmul(pkg::eye(3)); false } catch _: SparseError { true });
}

#[test]
fn add_scale_kron() {
    let a = random(6, 5, 2, 0.0, 3);
    let b = random(6, 5, 2, 0.0, 4);
    let (da, db) = (dense(a), dense(b));
    assert((try! a.add(b)).to_dense().all_close(da .+ db));
    assert((try! a.sub(b)).to_dense().all_close(da .- db));
    assert((a + b).to_dense().all_close(da .+ db));
    assert((a - b).to_csc() == (try! a.to_csc().sub(b.to_csc())));
    assert((a * 2.5).to_dense().all_close(da .* 2.5));
    assert((-a).to_dense() == da .* -1.0);
    let k = pkg::kron(a, b);
    assert(k.to_dense().all_close(linalg::kron(da, db)));
    assert(try { _ = try a.add(pkg::eye(3)); false } catch _: SparseError { true });
}

#[test]
fn get_and_equality() {
    let a = try! Csr::from_triplets([2, 2], [0, 1], [1, 1], [3.0, 4.0]);
    assert(a.get(0, 1) == 3.0 && a.get(0, 0) == 0.0 && a.to_csc().get(1, 1) == 4.0);
    assert(a != pkg::eye(2) && a == a.clone());
    assert(f"{a:?}" == "Csr(2 x 2, 2 stored)");
}
