use pkg::tests::suite::{dense, random, rvec};
use core::array::Vector;
use linalg::ops::*;

#[test]
fn operators() {
    let a = random(10, 10, 3, 4.0, 2);
    let x = rvec(10, 3);
    assert((a @ x).all_close(try! a.matvec(x)));
    assert((a ⊡ x) == (a @ x));
    assert((a @ a).to_dense().all_close(try! linalg::matmul(dense(a), dense(a)), abs: 1e-14));
    assert((a @ dense(a)).all_close(try! linalg::matmul(dense(a), dense(a)), abs: 1e-14));
    assert((a.to_csc() @ x).all_close(a @ x));
    assert(a† == a.t() && a†† == a);
    let b = a @ x;
    let y = try! (a \ b).get();
    assert(y.all_close(x, abs: 1e-12));
    assert((try! (a.to_csc() ⧵ b).get()).all_close(x, abs: 1e-12));
    let z = try! pkg::diags([[0.0, 1.0]], [0], [2, 2]);
    let one: Vector<f64> = [1, 1];
    assert((z \ one).is_err());
}
