//! linalg's operators on sparse matrices (feature `ops`, on by default):
//!
//!   a @ x, a ⊡ x    product with a vector, a dense matrix or a sparse matrix
//!   a \ b, a ⧵ b    solve a x = b by sparse LU (a Result)
//!   a†              transpose, as the other form sharing the arrays
//!
//! The tokens are linalg's (`linalg::ops`); `use linalg::ops::*` brings
//! them into scope.

use pkg::{Csc, Csr, SparseError};
use core::array::{Matrix, Vector};
use linalg::ops::{Adjoint, MatMul, Solve};

#[track_caller]
fn fit(a: [usize; 2], b: str, ok: bool) {
    if !ok { panic(f"⊡: a {a[0]} x {a[1]} matrix and {b} do not fit; the columns of a must equal the rows of b"); }
}

/// `a @ x`: `A x` for a vector, `A B` for a dense or a sparse matrix of
/// the same form. Binds like `*`; a shape mismatch panics (`matvec`
/// throws instead).
///
/// ```nabi
/// use linalg::ops::*;
/// use core::array::{Matrix, Vector};
///
/// let a = try sparse::diags([[2.0], [1.0]], [0, 1], [3, 3]);
/// let x: Vector<f64> = [1, 1, 1];
/// assert((a @ x).to_list() == [3.0, 3.0, 2.0]);
/// assert((a @ a).get(0, 1) == 4.0);
/// let m: Matrix<f64> = [[1, 0], [0, 1], [1, 1]];
/// assert((a @ m)[1, 1] == 3.0);
/// assert((a.to_csc() @ x).to_list() == [3.0, 3.0, 2.0]);
/// ```
impl MatMul<core::array::Array<f64, 1>> for Csr {
    type Output = Vector<f64>;
    #[track_caller]
    fn matmul(self, rhs: Vector<f64>) -> Vector<f64> {
        fit(self.shape(), f"a vector of {rhs.len()}", rhs.len() == self.shape()[1]);
        try! self.matvec(rhs)
    }
}

impl MatMul<core::array::Array<f64, 2>> for Csr {
    type Output = Matrix<f64>;
    #[track_caller]
    fn matmul(self, rhs: Matrix<f64>) -> Matrix<f64> {
        let t = rhs.shape();
        fit(self.shape(), f"{t[0]} x {t[1]}", t[0] == self.shape()[1]);
        try! self.matmul_dense(rhs)
    }
}

impl MatMul<Csr> for Csr {
    type Output = Csr;
    #[track_caller]
    fn matmul(self, rhs: Csr) -> Csr {
        let t = rhs.shape();
        fit(self.shape(), f"{t[0]} x {t[1]}", t[0] == self.shape()[1]);
        try! Csr::matmul(self, rhs)
    }
}

impl MatMul<core::array::Array<f64, 1>> for Csc {
    type Output = Vector<f64>;
    #[track_caller]
    fn matmul(self, rhs: Vector<f64>) -> Vector<f64> {
        fit(self.shape(), f"a vector of {rhs.len()}", rhs.len() == self.shape()[1]);
        try! self.matvec(rhs)
    }
}

impl MatMul<Csc> for Csc {
    type Output = Csc;
    #[track_caller]
    fn matmul(self, rhs: Csc) -> Csc {
        let t = rhs.shape();
        fit(self.shape(), f"{t[0]} x {t[1]}", t[0] == self.shape()[1]);
        try! Csc::matmul(self, rhs)
    }
}

/// `a \ b`: `x` with `A x = b` by sparse LU (`lu(a).solve(b)`).
/// Operators do not throw, so the answer is a `Result`.
///
/// ```nabi
/// use linalg::ops::*;
/// use core::array::Vector;
///
/// let a = try sparse::diags([[2.0], [1.0]], [0, 1], [2, 2]);
/// let b: Vector<f64> = [3, 2];
/// assert(try (a \ b).get() == Vector::<f64>::from([1.0, 1.0]));
/// ```
impl Solve<core::array::Array<f64, 1>> for Csr {
    type Output = Vector<f64>;
    fn solve(self, rhs: Vector<f64>) -> Result<Vector<f64>, linalg::LinalgError> {
        Result::catching(|| try linalg_error(self, rhs))
    }
}

impl Solve<core::array::Array<f64, 1>> for Csc {
    type Output = Vector<f64>;
    fn solve(self, rhs: Vector<f64>) -> Result<Vector<f64>, linalg::LinalgError> {
        Result::catching(|| try linalg_error(self.to_csr(), rhs))
    }
}

// linalg's `Solve` fixes the error type, so a sparse error is carried
// over as the nearest linalg one.
fn linalg_error(a: Csr, b: Vector<f64>) throws (linalg::LinalgError) -> Vector<f64> {
    try {
        try (try pkg::lu(a)).solve(b)
    } catch e: SparseError {
        throw match e {
            SparseError::Singular { column } => linalg::LinalgError::Singular { pivot: column },
            SparseError::NotSquare { rows, cols } => linalg::LinalgError::NotSquare { rows, cols },
            SparseError::NotFinite => linalg::LinalgError::NotFinite,
            other => linalg::LinalgError::ShapeMismatch { what: f"{other}" },
        };
    }
}

/// `a†`: the transpose, in the other form, sharing the arrays (O(1)).
///
/// ```nabi
/// use linalg::ops::*;
///
/// let a = try sparse::Csr::from_triplets([2, 3], [0], [2], [5.0]);
/// assert(a†.shape() == [3, 2] && a†.get(2, 0) == 5.0);
/// assert(a†† == a);
/// ```
impl Adjoint for Csr {
    type Output = Csc;
    fn adjoint(self) -> Csc { self.t() }
}

impl Adjoint for Csc {
    type Output = Csr;
    fn adjoint(self) -> Csr { self.t() }
}
